{
  "name": "ci-platform",
  "version": "0.9.0",
  "private": true,
  "description": "CI platform actions, workflow for GitHub Actions",
  "repository": {
    "type": "git",
    "url": "https://github.com/aglabo/ci-platform.git"
  },
  "license": "MIT",
  "author": "atsushifx <https://github.com/atsushifx>",
  "type": "module",
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "scan:secrets": "concurrently --raw --group \"bash runners/run-betterleaks.sh\" \"secretlint\"",
    "check:dprint": "dprint check --list-different",
    "check:dprint:diff": "dprint check",
    "format:dprint": "dprint fmt",
    "check:sh": "cross-env MSYS=NOGLOB bash runners/run-shfmt.sh --list ",
    "format:sh": "cross-env MSYS=NOGLOB bash runners/run-shfmt.sh --format ",
    "lint:sh": "cross-env MSYS=NOGLOB bash runners/run-shellcheck.sh ",
    "test:sh": "bash runners/run-shellspec.sh ",
    "test:sh:all": "bash runners/run-shellspec.sh all",
    "test:sh:unit": "bash runners/run-shellspec.sh unit",
    "test:sh:functional": "bash runners/run-shellspec.sh functional",
    "test:sh:integration": "bash runners/run-shellspec.sh integration --integration",
    "test:sh:e2e": "bash runners/run-shellspec.sh e2e",
    "lint:gha": "concurrently --raw --group \"pnpm run lint:gha:actions\" \"pnpm run lint:gha:workflows\"",
    "lint:gha:actions": "bash runners/run-actionlint.sh ",
    "lint:gha:workflows": "concurrently --raw --group \"bash runners/run-ghalint.sh run\" \"bash runners/run-ghalint.sh act\"",
    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "cross-env MSYS='NOGLOB' bash runners/run-textlint.sh ",
    "lint:markdown": "cross-env MSYS='NOGLOB' bash runners/run-markdownlint.sh ",
    "site:dev": "pnpm run --dir aglabo.github.io start",
    "site:build": "pnpm run --dir aglabo.github.io build:docs"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
